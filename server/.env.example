# ─── Configuration du service de vérification d'e-mail FSRS ───
# Copiez ce fichier en « .env » et renseignez vos valeurs.

# Port d'écoute du serveur
PORT=3000

# ─── SMTP : envoi des e-mails de vérification ───
# Laissez SMTP_HOST vide pour le mode développement
# (les codes s'affichent alors dans la console au lieu d'être envoyés).
#
# Exemple Gmail   : SMTP_HOST=smtp.gmail.com  / SMTP_PORT=587 / mot de passe d'application
# Exemple OVH/IONOS : SMTP_HOST=ssl0.ovh.net / SMTP_PORT=465 / SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Adresse expéditeur affichée dans l'e-mail
MAIL_FROM="FSRS — Fédération Sénégalaise de Roller & Skateboard <secretariat@fsrollerskate.com>"
